    {
        "id": "format_hazard",
        "type": "function",
        "name": "Format Log",
        "func": "let h = msg.payload;\nif (typeof h === 'string' || Buffer.isBuffer(h)) { try { h = JSON.parse(h.toString()); } catch(e) { return null; } }\nif (!h || !h.node_id) return null;\nlet node_id = h.node_id || \"Unknown\";\nlet t_val = Number(h.T||0);\nlet p_val = Number(h.ppm||0);\nlet f_val = h.flame ? 1 : 0;\nlet color = (f_val === 1 || t_val > 47) ? '#ff5555' : ((p_val > 11) ? '#ffaa00' : '#55ff55');\nlet html = `<span style=\"color:${color}\">[${node_id}] Temp: ${t_val.toFixed(1)}&deg;C | Smoke: ${p_val.toFixed(1)} PPM | Flame: ${f_val}</span>`;\nmsg.payload = html;\nreturn msg;",
        "outputs": 1,
        "x": 350,
        "y": 260,
        "wires": [
            [
                "ui_log_hazard"
            ]
        ]
    },
    {
        "id": "ui_log_hazard",
        "type": "ui_template",
        "group": "group_logs",
        "name": "Live Sensor Feed",
        "order": 1,
        "width": 12,
        "height": 6,
        "format": "<h2>Live Sensor Feed</h2><div style=\"height:100%; overflow-y:auto; background:#111; color:#fff; padding:15px; font-family:monospace; border-radius:8px; border-left: 5px solid #fb8c00;\" id=\"hazard-log\"></div><script>(function(scope){scope.$watch('msg',function(msg){if(msg&&msg.payload){var log=document.getElementById('hazard-log');if(log){log.innerHTML=msg.payload+'<br>'+log.innerHTML;var lines=log.innerHTML.split('<br>');if(lines.length>15)log.innerHTML=lines.slice(0,15).join('<br>');}}});})(scope);</script>",
        "x": 600,
        "y": 260,
        "wires": [
            []
        ]
    },
    {
        "id": "calc_analytics",
        "type": "function",
        "name": "Extract Analytics",
        "func": "let h = msg.payload;\nif (typeof h === 'string' || Buffer.isBuffer(h)) { try { h = JSON.parse(h.toString()); } catch(e) { return null; } }\nif (!h || !h.node_id) return null;\n\nlet nodes = context.get('nodes') || {};\nnodes[h.node_id] = h;\ncontext.set('nodes', nodes);\n\nlet maxTemp = 0;\nlet maxSmoke = 0;\nlet hazardCount = 0;\nlet fireZones = [];\n\nfor (let id in nodes) {\n    if (nodes[id].T > maxTemp) maxTemp = nodes[id].T;\n    if (nodes[id].ppm > maxSmoke) maxSmoke = nodes[id].ppm;\n    if (nodes[id].T > 47 || nodes[id].ppm > 11 || nodes[id].flame) {\n        hazardCount++;\n        fireZones.push(id);\n    }\n}\n\nlet fireHtml = \"\";\nif (fireZones.length > 0) {\n    fireHtml = \"<div style='display:flex; flex-wrap:wrap; gap:10px;'>\";\n    for(let i=0; i<fireZones.length; i++){\n        fireHtml += `<div style='background:#e53935; color:white; padding:8px 15px; border-radius:5px; font-weight:bold; box-shadow: 0 0 10px #e53935;'>\\uD83D\\uDD25 ${fireZones[i]}</div>`;\n    }\n    fireHtml += \"</div>\";\n} else {\n    fireHtml = \"<div style='color:#4CAF50; font-weight:bold; font-size:18px;'>\\u2705 All zones clear</div>\";\n}\n\nreturn [{payload: maxTemp}, {payload: maxSmoke}, {payload: hazardCount}, {payload: hazardCount}, {payload: fireHtml}];",
        "outputs": 5,
        "x": 350,
        "y": 340,
        "wires": [
            [
                "chart_temp"
            ],
            [
                "gauge_smoke",
                "hvac_logic"
            ],
            [
                "gauge_hazard_ratio"
            ],
            [
                "tts_trigger"
            ],
            [
                "ui_fire_map"
            ]
        ]
    },
