        "order": 1,
        "width": 12,
        "height": 10,
        "format": "<div layout=\"column\" layout-align=\"center center\"><h2 style=\"color:#fff; margin-bottom:15px;\">Floor-by-Floor Evacuation Layout</h2><div id=\"live-grid-container\"></div></div><script>(function(scope){scope.$watch('msg',function(msg){if(msg&&msg.payload){var c=document.getElementById('live-grid-container');if(c)c.innerHTML=msg.payload;}});})(scope);</script>",
        "x": 400,
        "y": 420,
        "wires": [
            []
        ]
    },
    {
        "id": "tts_paths",
        "type": "function",
        "name": "Play End of Sim TTS",
        "func": "let obj = msg.payload;\nif (typeof obj === 'string' || Buffer.isBuffer(obj)) { try { obj = JSON.parse(obj.toString()); } catch(e) { return null; } }\nif (obj && obj.tts) { return {payload: obj.tts}; }\nreturn null;",
        "outputs": 1,
        "x": 400,
        "y": 220,
        "wires": [
            [
                "ui_audio_out"
            ]
        ]
    },
    {
        "id": "ui_text_paths",
        "type": "ui_template",
        "group": "group_routes",
        "name": "Victim Routes",
        "order": 1,
        "width": 12,
        "height": 4,
        "format": "<div layout=\"row\" layout-align=\"space-between\"><h2>Real-Time Evacuation Paths</h2></div><div ng-bind-html=\"msg.payload\" style=\"padding:15px; background:#222; color:white; border-radius:8px; border-left: 5px solid #00acc1;\"></div><style>.led-chase { display: inline-block; width: 12px; height: 12px; border-radius: 50%; background: #00ff00; margin: 0 4px; animation: chase 1.5s infinite linear; box-shadow: 0 0 8px #00ff00; } @keyframes chase { 0% { opacity: 0.2; transform: scale(0.8); } 50% { opacity: 1; transform: scale(1.2); } 100% { opacity: 0.2; transform: scale(0.8); } } .path-arrow { display:inline-flex; align-items:center; } </style>",
        "x": 600,
        "y": 180,
        "wires": [
            []
        ]
    },
