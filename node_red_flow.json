        "format": "<div id=\"health-container\"></div>\n<script>\n(function(scope) {\n    scope.$watch('msg', function(msg) {\n        if (msg && msg.payload) {\n            var c = document.getElementById('health-container');\n            if (c) c.innerHTML = msg.payload;\n        }\n    });\n})(scope);\n</script>",
