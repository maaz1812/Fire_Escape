    {
        "id": "mqtt_in_path",
        "type": "mqtt in",
        "name": "Listen to Paths",
        "topic": "fireRouter/honeywell/path",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "mqtt_broker_1",
        "x": 150,
        "y": 200,
        "wires": [
            [
                "format_paths"
            ]
        ]
    },
    {
        "id": "format_paths",
        "type": "function",
        "name": "Format Paths + ETA",
        "func": "let html = \"\";\ntry {\n    let obj = msg.payload;\n    if (typeof obj === 'string' || Buffer.isBuffer(obj)) { obj = JSON.parse(obj.toString()); }\n    if (obj && obj.victim_paths) {\n        html = '<ul style=\"font-size: 18px; line-height: 1.5; padding-left: 20px;\">';\n        for (let victim in obj.victim_paths) {\n            let path = obj.victim_paths[victim];\n            if (!path || path.length === 0) {\n                html += `<li><b style=\"color:#ff5555;\">${victim}:</b> Trapped! No safe route!</li>`;\n            } else {\n                let routeStr = path.join(' <span class=\"led-chase\"></span> ');\n                let eta = (path.length * 1.5).toFixed(1);\n                html += `<li><b style=\"color:#55ff55;\">${victim}:</b> <span class=\"path-arrow\">${routeStr}</span> <span style=\"color:#00acc1; font-weight:bold;\">[ETA: ${eta}s]</span></li>`;\n            }\n        }\n        html += '</ul>';\n    } else {\n        html = `<p style=\"color:#ffaa00;\">Waiting for valid path data...</p>`;\n    }\n} catch(err) {\n    html = `<p style=\"color:#ff5555;\">Error parsing path data.</p>`;\n}\nmsg.payload = html;\nreturn msg;",
        "outputs": 1,
        "x": 350,
        "y": 380,
        "wires": [
            [
                "ui_text_paths"
            ]
        ]
    },
    {
        "id": "mqtt_in_sim_complete",
        "type": "mqtt in",
