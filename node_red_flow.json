    {
        "id": "tts_trigger",
        "type": "function",
        "name": "Trigger TTS Alarm",
        "func": "let rooms = msg.payload;\nlet wasFire = context.get(\"wasFire\") || false;\nlet isFire = (rooms > 0);\n\nif (isFire && !wasFire) {\n    context.set(\"wasFire\", true);\n    return {payload: \"Warning! Fire hazard detected. Commencing dynamic evacuation.\"};\n} else if (!isFire && wasFire) {\n    context.set(\"wasFire\", false);\n    return {payload: \"Hazard resolved. System returning to normal.\"};\n}\nreturn null;",
        "outputs": 1,
        "x": 600,
        "y": 420,
        "wires": [
            []
        ]
    },
