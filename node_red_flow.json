    {
        "id": "mqtt_in_hazard",
        "type": "mqtt in",
        "name": "Listen to Hazards",
        "topic": "fireRouter/honeywell/hazard/+",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "mqtt_broker_1",
        "x": 150,
